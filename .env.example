# ---- 数据库（三选一，都不填则本地 file:./data/erciyuan.db，Vercel 上退化为内存库）----
# Turso / LibSQL 实例（生产推荐）
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# 也可使用 TURSO_* 命名
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ---- 会话签名（生产环境必填，随机 32 字节以上）----
AUTH_SECRET=

# ---- 可选 ----
# 站点正式域名，用于 SEO / OG 分享卡片的绝对地址
NEXT_PUBLIC_SITE_URL=https://erciyuan.fuwari.fun
# 演示短信：设为 1 时注册接口会把验证码直接返回给前端，并允许万能码 123456
DEMO_SMS=1
# Bangumi 接口镜像/网关（大陆直连受阻时填写），默认 https://api.bgm.tv
# BANGUMI_API_BASE=
