# ---- 数据库（都不填则本地 file:./data/erciyuan.db，Vercel 上退化为内存库，写入不持久）----
# 方案 A：Cloudflare D1（HTTP 接口，适配器见 lib/db/d1.ts）
#   DATABASE_URL=d1://<account_id>/<database_uuid>
#   DATABASE_AUTH_TOKEN=<Cloudflare API Token，权限 Account / D1 / Edit>
# 可选：本地联调或自建兼容端点时覆盖 API 根地址，默认 https://api.cloudflare.com/client/v4
# D1_API_BASE_URL=

# 方案 B：Turso / LibSQL 实例
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# 也可使用 TURSO_* 命名
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ---- 会话签名（生产环境必填，随机 32 字节以上）----
AUTH_SECRET=

# ---- 可选 ----
# 站点正式域名，用于 SEO / OG 分享卡片的绝对地址
NEXT_PUBLIC_SITE_URL=https://erciyuan.fuwari.fun
# 演示短信：设为 1 时注册接口会把验证码直接返回给前端，并允许万能码 123456
DEMO_SMS=1
# Bangumi 接口镜像/网关（大陆直连受阻时填写），默认 https://api.bgm.tv
# BANGUMI_API_BASE=
